# Environment Variables Example

# Server Configuration
PORT=3000

# External Port (the port exposed to host machine)
# Change this if port 80 is already in use
EXTERNAL_HTTP_PORT=8080
EXTERNAL_HTTPS_PORT=8443

# Optional: prebuilt image used by docker-compose.image.yml
# SUBCONVERTER_IMAGE=ghcr.io/saberlayer/subconverter-x:latest

# Optional: deployment mode used by start.sh
# image = pull/use prebuilt image, source = build from local source
# DEPLOY_MODE=image

# Domain Configuration (optional)
# If you have a domain, set it here for SSL support
# DOMAIN=example.com

# SSL Configuration (optional)
# Set to "true" to enable HTTPS with Let's Encrypt
# ENABLE_SSL=false
# SSL_EMAIL=your-email@example.com

# Database Configuration
DB_PATH=./data/subconverter-x.db

# Optional: short subscription link retention period in days
# SUBSCRIPTION_TTL_DAYS=90

# Optional: Remote Rule Fetch Timeout (in milliseconds)
# RULE_FETCH_TIMEOUT=8000

# Optional: Subscription Fetch Timeout (in milliseconds)
# SUBSCRIPTION_FETCH_TIMEOUT=10000
