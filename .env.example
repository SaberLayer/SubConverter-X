# 环境变量示例

# 服务配置
PORT=3000

# 对外端口（暴露给宿主机的端口）
# 如果 80 端口已被占用，请修改这里
EXTERNAL_HTTP_PORT=8080
EXTERNAL_HTTPS_PORT=8443

# 可选：docker-compose.image.yml 使用的预构建镜像
# SUBCONVERTER_IMAGE=ghcr.io/saberlayer/subconverter-x:latest

# 可选：start.sh 使用的部署模式
# image = 拉取/使用预构建镜像，source = 从本地源码构建
# DEPLOY_MODE=image

# 域名配置（可选）
# 如果你有域名，可在这里配置以启用 SSL 支持
# DOMAIN=example.com

# SSL 配置（可选）
# 设置为 "true" 可通过 Let's Encrypt 启用 HTTPS
# ENABLE_SSL=false
# SSL_EMAIL=your-email@example.com

# 数据库配置
DB_PATH=./data/subconverter-x.db

# 可选：短订阅链接保留天数
# SUBSCRIPTION_TTL_DAYS=90

# 可选：远程规则拉取超时时间（毫秒）
# RULE_FETCH_TIMEOUT=8000

# 可选：订阅拉取超时时间（毫秒）
# SUBSCRIPTION_FETCH_TIMEOUT=10000

# 可选：拉取远程订阅、规则或配置模板时使用的出站代理
# HTTP_PROXY=http://proxy.example.com:7890
# HTTPS_PROXY=http://proxy.example.com:7890
