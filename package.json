{
  "name": "subconverter-x",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:backend": "npm run dev -w packages/backend",
    "dev:frontend": "npm run dev -w packages/frontend",
    "build": "npm run build -w packages/frontend && npm run build -w packages/backend && npm run sync:frontend",
    "start": "npm run start -w packages/backend",
    "sync:frontend": "node scripts/sync-frontend.mjs",
    "test:regression": "npm run test:regression -w packages/backend"
  }
}
